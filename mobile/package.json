{
  "name": "sovel-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.14",
    "expo-asset": "^58.0.16",
    "expo-audio": "58.0.9",
    "expo-blur": "~58.0.4",
    "expo-file-system": "^58.0.9",
    "expo-linear-gradient": "^58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-sqlite": "^58.0.13",
    "expo-status-bar": "~58.0.3",
    "music-metadata": "^12.2.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "^15.16.0",
    "strtok3": "^10.6.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-unicode-sets-regex": "^7.29.7",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.17",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:dsd:native": "bash native/dsd/tests/run-native.sh",
    "test:dsd:extractor": "bash native/dsd/tests/run-jvm.sh",
    "test:scan:native": "bash modules/sovel-access/tests/run.sh",
    "check": "npm run typecheck && npm test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "postinstall": "node scripts/patch-audio-equalizer.mjs && node scripts/patch-audio-playback.mjs",
    "prestart": "node scripts/patch-audio-equalizer.mjs && node scripts/patch-audio-playback.mjs",
    "preios": "node scripts/patch-audio-equalizer.mjs && node scripts/patch-audio-playback.mjs",
    "preandroid": "node scripts/patch-audio-equalizer.mjs && node scripts/patch-audio-playback.mjs",
    "lint": "eslint src tests"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  }
}
